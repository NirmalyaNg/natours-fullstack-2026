extends _baseEmail

block content
  p Hi #{firstName},
  p We received a request to reset the password for your Natours account.
  p Use the link below to choose a new password. It's valid for only 10 minutes.
  table(role='presentation' cellpadding='0' cellspacing='0')
    tr
      td
        a.btn(href=url target='_blank') Reset your password
  p
  p.muted If you didn't request a password reset, you can safely ignore this email. Your password won't change.