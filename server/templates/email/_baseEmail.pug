doctype html
html
  head
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    meta(http-equiv='Content-Type' content='text/html; charset=UTF-8')
    title= subject
    style.
      body { margin: 0; padding: 0; background-color: #f6f6f6; font-family: Arial, sans-serif; font-size: 15px; line-height: 1.5; color: #333333; }
      .wrapper { width: 100%; background-color: #f6f6f6; padding: 24px 0; }
      .container { max-width: 560px; margin: 0 auto; }
      .content { background-color: #ffffff; border-radius: 6px; padding: 32px; }
      .brand { font-size: 22px; font-weight: bold; color: #28b485; margin: 0 0 24px; }
      p { margin: 0 0 16px; }
      .btn { display: inline-block; background-color: #55c57a; color: #ffffff !important; text-decoration: none; font-weight: bold; padding: 12px 28px; border-radius: 4px; }
      .muted { font-size: 13px; color: #888888; }
      .footer { text-align: center; font-size: 12px; color: #999999; padding: 16px; }

  body
    table.wrapper(role='presentation' cellpadding='0' cellspacing='0')
      tr
        td
          .container
            .content
              p.brand Natours
              block content
            .footer
              p Natours &middot; Exploring the world, one tour at a time